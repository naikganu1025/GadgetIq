# =====================================================================
# GADGETIQ — AI Gadget Intelligence & Diagnostics Platform
# Environment Configuration Template (.env.example)
# =====================================================================

# Primary Multimodal Vision & Intelligence AI (Google Gemini)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Live Web Research & Source Verification API (Tavily AI)
# Get key: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Alternative Search API (SerpAPI) [Optional]
# Get key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Alternative AI Provider (OpenAI) [Optional]
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Database Connection (SQLite by default for quick start, or PostgreSQL)
DATABASE_URL=sqlite:///./gadgetiq.db

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=50
JWT_SECRET=gadgetiq_development_secret_key
